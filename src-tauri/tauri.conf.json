{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axion Consulta",
  "version": "1.0.0",
  "identifier": "com.axion.consulta",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AXION Consulta",
        "width": 1000,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
